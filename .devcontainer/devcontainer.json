{
    "dockerComposeFile": [
        "../docker-compose.yaml"
    ],
    "service": "development",

    "remoteUser": "ubuntu",

    "workspaceFolder": "/workspace",

    "mounts": [
        {"type":"bind","source":"${localWorkspaceFolder}","target":"/workspace"},
        {"type":"volume","source":"cpplox-cache", "target":"/home/ubuntu/.cache"},
        {"type":"volume","source":"cpplox-config", "target":"/home/ubuntu/.config"},
        {"type":"bind","source":"${localEnv:HOME}/.ssh", "target":"/home/ubuntu/.ssh"}
    ],

    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/pre-commit:2": {}
    },

    "postCreateCommand": "sudo chown -R 1000:1000 /home/ubuntu/.cache || true"
}
